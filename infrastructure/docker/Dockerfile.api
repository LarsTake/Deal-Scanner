FROM node:24-alpine AS extension-build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
COPY . .
RUN node infrastructure/scripts/prepare-docker-node.mjs
RUN --mount=type=cache,id=deal-scanner-pnpm,target=/pnpm/store \
    pnpm --store-dir /pnpm/store --filter @deal-scanner/browser-extension install --frozen-lockfile --child-concurrency=1 --network-concurrency=4 \
    && pnpm --filter @deal-scanner/browser-extension build

FROM ghcr.io/astral-sh/uv:0.11.30-python3.12-trixie-slim@sha256:15b3f37555160b42939585003c7c8ad96ab1959fd9367b10afd7690176b7840e

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
COPY . .
COPY --from=extension-build /app/apps/browser-extension/dist /tmp/browser-extension-dist
RUN python infrastructure/scripts/package_browser_extension.py --source /tmp/browser-extension-dist
RUN uv sync --frozen --package deal-scanner-api --no-dev
RUN groupadd --system deal-scanner && useradd --system --gid deal-scanner --home-dir /app deal-scanner \
    && mkdir -p /app/.data && chown -R deal-scanner:deal-scanner /app/.data

EXPOSE 8000
USER deal-scanner
CMD ["uvicorn", "deal_scanner_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
