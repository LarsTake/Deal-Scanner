{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deal Scanner",
  "version": "0.1.0",
  "identifier": "de.dealscanner.desktop",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://127.0.0.1:4200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Deal Scanner",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 https://*.supabase.co; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "shortDescription": "Nachvollziehbare Deal- und Risikoanalyse",
    "longDescription": "Deal Scanner importiert sichtbare Angebote und bewertet Marktwert, Deal-Potenzial und Risiken getrennt."
  }
}
