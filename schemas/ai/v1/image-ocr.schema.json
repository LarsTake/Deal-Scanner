{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deal-scanner.local/schemas/ai/v1/image-ocr.schema.json",
  "title": "ImageOcrResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["imageId", "text", "confidence", "engine", "schemaVersion"],
  "properties": {
    "imageId": { "type": "string", "format": "uuid" },
    "text": { "type": "string", "maxLength": 100000 },
    "language": { "type": ["string", "null"], "maxLength": 32 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "engine": { "type": "string", "minLength": 1, "maxLength": 64 },
    "schemaVersion": { "const": "1.0.0" }
  }
}
