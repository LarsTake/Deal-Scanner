{
  "manifest_version": 3,
  "name": "Deal Scanner Import",
  "version": "0.3.0",
  "description": "Importiert Kleinanzeigen-Angebote einschließlich Beschreibungen nach Nutzeraktion, optional über mehrere Seiten.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.kleinanzeigen.de/*",
    "https://kleinanzeigen.de/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Deal Scanner" },
  "content_scripts": [
    {
      "matches": ["https://www.kleinanzeigen.de/*", "https://kleinanzeigen.de/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
